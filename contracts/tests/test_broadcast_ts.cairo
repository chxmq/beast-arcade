#[test]
fn ts_submit_broadcast_raw_calldata() {
    let t0: u64 = 1763337600 + 3600;
    start_cheat_block_timestamp_global(t0);
    let (reg_addr, _) = declare("MockRegistry")
        .unwrap()
        .contract_class()
        .deploy(@array![])
        .unwrap();
    let (nft_addr, _) = declare("MockBeasts")
        .unwrap()
        .contract_class()
        .deploy(@array![reg_addr.into()])
        .unwrap();
    let (addr, _) = declare("StaticGame")
        .unwrap()
        .contract_class()
        .deploy(@array![owner().into(), reg_addr.into(), nft_addr.into()])
        .unwrap();
    let registry = IMockRegistryDispatcher { contract_address: reg_addr };
    registry.set_definition(10011, 0, 3);
    registry.set_definition(10012, 1, 2);
    registry.set_definition(10013, 2, 4);
    registry.set_definition(1, 0, 1);
    registry.set_definition(2, 1, 5);
    registry.set_definition(3, 2, 3);
    let game = IStaticGameDispatcher { contract_address: addr };
    start_cheat_caller_address(addr, owner());
    game
        .set_roster(
            array![
                RosterInput {
                    species_id: 10011,
                    health: 0,
                    w: 48,
                    h: 40,
                    occ: 0x3c7effffffff7e3c,
                    kill_token: 0,
                    base_kills: 0
                },
                RosterInput {
                    species_id: 10012,
                    health: 120,
                    w: 40,
                    h: 32,
                    occ: 0xffffffffffffffff,
                    kill_token: 0,
                    base_kills: 1
                },
                RosterInput {
                    species_id: 10013,
                    health: 100,
                    w: 56,
                    h: 48,
                    occ: 0x7e7e7e7e7e7e7e7e,
                    kill_token: 0,
                    base_kills: 7
                },
                RosterInput {
                    species_id: 1,
                    health: 80,
                    w: 32,
                    h: 32,
                    occ: 0xffff00ffff00ff,
                    kill_token: 0,
                    base_kills: 0
                },
                RosterInput {
                    species_id: 2,
                    health: 100,
                    w: 64,
                    h: 56,
                    occ: 0xffffffffffffffff,
                    kill_token: 0,
                    base_kills: 3
                },
                RosterInput {
                    species_id: 3,
                    health: 150,
                    w: 24,
                    h: 24,
                    occ: 0x8142241818244281,
                    kill_token: 0,
                    base_kills: 0
                },
            ],
            3,
        );
    game.set_relayer(relayer(), true);
    start_cheat_caller_address(addr, relayer());
    let root_id = game
        .post_tape_root(
            0x106fd2c2450b16ae2147286f44cbe3682e27989a013c11e34c529ba9893f78f, 4, t0 + 86400,
        );
    assert_eq!(root_id, 1);
    assert_eq!(
        game.tape_index(1, 0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35, 1), 2
    );
    // Exactly the calldata server/chain.ts submitCalldata() builds for the relayer.
    let calldata = array![
        0x1, 0x2, 0x1, 0x445b82e223ca6cfa6001313e051fa910904ecf3b36b23ee76f340627caecf96, 0x2,
        0x1685d6e1db61daf5931a2a50541454dabe80a86ab9355d00323f8a2a9f84cc9,
        0x3a5e93ed191d26f20dde7eb4411c431509d2e91245b8b08c49448770745037,
        0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35, 0x545352454c4159, 0x19,
        0xc33094, 0xdb289c, 0x12308b8, 0x16ae8d0, 0x22264f0, 0x23a5cf8, 0x2824908, 0x2ca311c,
        0x36a0d08, 0x381fd0c, 0x3c9d114, 0x411a11c, 0x478109c, 0x4900894, 0x4d81488, 0x520287c,
        0x5f2d460, 0x60adc5c, 0x652f848, 0x69b1438, 0x7013d34, 0x719412c, 0x7615914, 0x7a97100,
        0x2ee00000, 0x71ddebf3dd6cd73f410684ce60dcc8e3e5992b1ccc437a0562594acea937c4c,
        0x83010994d430d144cc253782c7d185059daf9d1389175b7ab443f123ad18b
    ];
    let ret = call_contract_syscall(addr, selector!("submit_broadcast"), calldata.span()).unwrap();
    assert_eq!(*ret.at(0), 1); // run_id
    stop_cheat_caller_address(addr);
    let run = game.get_run(1);
    assert_eq!(run.player_pub, 0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35);
    assert_eq!(run.callsign, 'TSRELAY');
    assert_eq!(run.k, 2);
    assert_eq!(run.seed, 0x445b82e223ca6cfa6001313e051fa910904ecf3b36b23ee76f340627caecf96);
    assert_eq!(run.score, 2163);
    assert_eq!(run.kills, 6);
    assert_eq!(run.lives, 0);
    assert_eq!(run.best_combo, 12);
    assert_eq!(run.caught_mask, 0x27);
    assert_eq!(run.dead, true);
    assert_eq!(run.digest, 0x1652224421b7278becb1a33f018a2e021f7ece463af54eb8b5f31a427c02bd);
    assert!(game.is_tape_used(1, 2));
    // Bestiary: the TS sim's masks and kill count land in the player's dex.
    assert_eq!(
        game.get_dex(0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35),
        (0x27, 0x20, 6)
