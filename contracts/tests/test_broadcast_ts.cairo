#[test]
fn ts_message_hash_and_tape_index() {
    assert_eq!('ACE42', 0x4143453432);
    assert_eq!(
        message_of(7, 1234, 0x2a, 'ACE42', array![0, 1058897, 1048575550].span()),
        0x59e1dfb271f34db3a104d084eb2ae9957dcded62dfdf67bce3e377836652065
    );
    assert_eq!(
        message_of(1, 0, 1, 'A', array![].span()),
        0x692cf7ebfa0b2a50e3f898cb9814d147f60649cfe70450b44c35cdf78bf24e6
    );
    assert_eq!(
        tape_index_of(0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35, 0x2a, 4096),
        3990
    );
    assert_eq!(
        tape_index_of(0xa5025b0891efdf15787cfc0a1105f623e7f5e00bc61a01da1f7304e1c2cf35, 0x2a, 5), 0
    );
}

