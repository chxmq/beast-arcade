# STATIC Broadcast server. Copy to .env.local for `npm run dev`, set the same keys in Vercel.
# Without STATIC_CONTRACT the API runs in offchain test mode (dev only): tapes stream, runs are
# replayed locally and the seed is revealed, nothing is sent to Starknet.

# StaticGame contract address (Sepolia)
STATIC_CONTRACT=
# Relayer account (must be allowed with set_relayer) and its private key
RELAYER_ADDRESS=
RELAYER_PK=
# Tape seed secret: 0x-hex felt < 2^251 (e.g. 31 random bytes). Never share; rotating it breaks open roots.
BROADCAST_SECRET=
# Starknet JSON-RPC (spec 0.9 or 0.10). Default: https://api.zan.top/public/starknet-sepolia/rpc/v0_10
RPC_URL=
# Leaves per daily root (default 4096)
TAPES_PER_DAY=
# Bearer token for /api/cron/post-root (Vercel cron sends it automatically when set)
CRON_SECRET=
